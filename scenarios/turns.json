        "turn": 0,
        "ships": [
          {
            "x": 1200,
            "y": 480,
            "heading": 0,
            "alive": true
          },
          {
            "x": 600,
            "y": 200,
            "heading": 180,
            "alive": true
          }
        ]
      },
      "steps": [
        {
          "call": "resolveMove",
          "move": {
            "distance": 150,
            "angle": 0
          }
        },
        {
          "call": "endTurn"
        }
      ],
      "pick": [
        "turn",
        "ships.0.alive",
        "ships.0.x",
        "ships.0.y",
        "ships.0.heading",
        "ships.1.x"
      ]
    },
    {
      "name": "double kill does not skip a turn",
