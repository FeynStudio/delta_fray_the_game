{
  "description": "rules.endTurn(state): respawns destroyed ships at config.spawns and passes the turn to the other player.",
  "overrides": {
    "maxMove": 150,
    "worldWidth": 1280,
    "worldHeight": 960,
    "shipSize": 30,
    "spawns": [
      {
        "x": 190,
        "y": 480,
        "heading": 0
      },
      {
        "x": 1090,
        "y": 480,
        "heading": 180
      }
    ]
  },
  "cases": [
    {
      "name": "destroyed enemy respawns and it becomes their turn (FEATURE_MAP 6)",
      "state": {
        "turn": 0,
        "ships": [
          {
            "x": 200,
            "y": 480,
            "heading": 0,
            "alive": true
          },
          {
            "x": 300,
            "y": 490,
            "heading": 180,
            "alive": true
          }
        ]
      },
      "steps": [
        {
          "call": "resolveMove",
          "move": {
            "distance": 150,
            "angle": 0
          }
        },
        {
          "call": "endTurn"
        }
      ],
      "pick": [
        "turn",
        "ships.1.alive",
        "ships.1.x",
        "ships.1.y",
        "ships.1.heading",
        "ships.0.x"
      ]
    },
    {
